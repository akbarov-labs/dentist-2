# Copy to .env and fill in. Without these, booking requests are only logged on the server.
# Bot token from @BotFather; the chat id where the doctor receives requests (message @userinfobot to find yours).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The real public address of the site, e.g. https://example.uz (used for canonical links, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=
